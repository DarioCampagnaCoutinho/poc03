{
  "info": {
    "name": "POC 03 - Health",
    "description": "Health check dos serviços da POC 03 (Nginx, PHP-FPM/Laravel, PostgreSQL e cache).\n\nVariável da coleção:\n- `base_url`: endereço da API (padrão `http://localhost:8000`)\n\nAs rotas `/api/health*` retornam 200 quando o serviço está ok e 503 quando falha.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Todos os serviços",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Serviço ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Verifica todos os serviços. Retorna 200 se todos estiverem ok e 503 se algum falhar."
      },
      "response": []
    },
