{
  "info": {
    "name": "POC 03 - Health",
    "description": "Health check da POC 03: verifica PHP, Nginx e PostgreSQL em uma única requisição.\n\nVariável da coleção:\n- `base_url`: endereço da API (padrão `http://localhost:8000`)\n\nRetorna 200 quando todos os serviços estão ok e 503 quando algum falha.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Todos os serviços ok', () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json.status).to.eql('ok');",
              "    pm.expect(json.services).to.eql({ php: 'ok', nginx: 'ok', postgresql: 'ok' });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Verifica PHP, Nginx e PostgreSQL. Retorna 200 se todos estiverem ok e 503 se algum falhar."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ]
}
